{
  "name": "agent-meshes",
  "version": "0.2.0",
  "private": true,
  "type": "module",
  "description": "Named-part 3D authoring, rigging and animation for coding agents",
  "engines": {
    "node": ">=24"
  },
  "bin": {
    "agent-meshes": "scripts/agent-meshes.mjs"
  },
  "scripts": {
    "test": "vitest run",
    "typecheck": "tsc --noEmit",
    "build": "vite build",
    "start": "node src/cli.ts serve",
    "dev": "vite --host 127.0.0.1",
    "examples": "npm run build && node scripts/build-creatures.mjs",
    "check:creatures": "node scripts/check-creatures.mjs",
    "setup": "node scripts/setup.js"
  },
  "dependencies": {
    "@dimforge/rapier3d-compat": "0.20.0",
    "commander": "15.0.0",
    "express": "5.2.1",
    "gltf-validator": "2.0.0-dev.3.10",
    "playwright": "1.63.0",
    "three": "0.186.0",
    "vite": "8.3.0",
    "zod": "4.6.5"
  },
  "devDependencies": {
    "@types/express": "5.0.6",
    "@types/node": "26.6.2",
    "@types/three": "0.186.0",
    "typescript": "7.0.2",
    "vitest": "5.0.1"
  }
}
